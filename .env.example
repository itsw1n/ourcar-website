# Supabase
# `make dev` derives local values from the running Supabase CLI stack and
# injects them into the development process. It does not write `.env.local`.
# The expected local API URL is http://127.0.0.1:54321.
# In production, configure the hosted Supabase values in the hosting platform.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Public business contact details used by header, hero, and contact CTAs.
# Without these, contact buttons render disabled. Replace with real values.
NEXT_PUBLIC_BUSINESS_PHONE=+15551234567
NEXT_PUBLIC_MESSENGER_URL=https://m.me/yourbusinesspage

# Canonical site URL used for metadata, sitemap, robots, and Open Graph.
NEXT_PUBLIC_SITE_URL=https://wings-buynsell.example.com

# Data source: "mock" for database-free development or "supabase" for Supabase.
NEXT_PUBLIC_DATA_SOURCE=mock

# ── Docker (optional) ──────────────────────────────────────────────────────
# For `make docker-prod`, copy this to `.env.prod` and fill with your HOSTED
# Supabase project values. The dev Docker flow (`make docker-dev`) injects the
# local Supabase vars automatically — no .env file needed for it.
