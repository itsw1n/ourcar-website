# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public business contact details
# Public business contact details (used by header / hero / contact CTAs).
# Without these, contact buttons render disabled (faded). Replace with real values.
NEXT_PUBLIC_BUSINESS_PHONE=+15551234567
NEXT_PUBLIC_MESSENGER_URL=https://m.me/yourbusinesspage

# Data source: "mock" (local dev, no Supabase) or "supabase" (production).
# Falls back to mock in dev, supabase in prod when NEXT_PUBLIC_SUPABASE_URL is set.
NEXT_PUBLIC_DATA_SOURCE=mock
