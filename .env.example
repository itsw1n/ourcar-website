# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public business contact details (used by header / hero / contact CTAs).
# Without these, contact buttons render disabled (faded). Replace with real values.
NEXT_PUBLIC_BUSINESS_PHONE=+15551234567
NEXT_PUBLIC_MESSENGER_URL=https://m.me/yourbusinesspage

# Data source: "mock" (local dev, no database) or "supabase" (real database).
# For full local Supabase dev, `make dev` injects the local Supabase vars and
# sets this to "supabase" automatically. Set it here only to force a mode.
NEXT_PUBLIC_DATA_SOURCE=mock
