# Example production environment — copy to `.env.prod` and fill with your
# HOSTED Supabase project values. `.env.prod` is gitignored.
#
# Used by `make docker-prod`:
#   - NEXT_PUBLIC_* are inlined into the client bundle at BUILD time (build args)
#   - SUPABASE_SERVICE_ROLE_KEY is read at RUNTIME by the server (private,
#     never exposed to the browser) for server-side data access.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

NEXT_PUBLIC_BUSINESS_PHONE=+15551234567
NEXT_PUBLIC_MESSENGER_URL=https://m.me/yourbusinesspage

# Force real database in production.
NEXT_PUBLIC_DATA_SOURCE=supabase
